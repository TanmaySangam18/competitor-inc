# competitor.inc — copy to .env.local and fill in. Everything is optional:
# with nothing set, the app runs fully in SIMULATED + local-storage mode (offline demo).

# ── Engine (swappable provider — the model is a commodity, never hardwired) ──
# MODEL_PROVIDER: "simulated" (default, offline) | "anthropic" | "gateway" | "openai-compatible"
# THIS is the one that makes the AI real — set it + the matching key below and the agents stop simulating.
MODEL_PROVIDER=simulated
# MODEL_ID is used by ALL real providers (for "gateway", use a "provider/model" string).
# Default: claude-sonnet-4-6 (the in-house agents run on Sonnet 4.6 for now).
MODEL_ID=claude-sonnet-4-6
# Per-agent routing: cheaper/faster model for non-strategic agents (Forge/Apex use MODEL_ID).
# Defaults to Sonnet 4.6 too for now; set e.g. claude-haiku-4-5 to split the lighter roles off later.
MODEL_CHEAP=claude-sonnet-4-6
#
# (a) Anthropic            → MODEL_PROVIDER=anthropic     (simplest; use Claude-for-Startups credits)
ANTHROPIC_API_KEY=
# (b) Vercel AI Gateway    → MODEL_PROVIDER=gateway       (one key, any provider via "provider/model")
AI_GATEWAY_API_KEY=
# (c) Any OpenAI-compatible / self-hosted host (OpenAI, Groq, OpenRouter, Together, Mistral,
#     DeepSeek, a local server, …) → MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
# Users can also Bring Their Own Key in the UI (stored only in their browser, sent per-request).

# ── Phase 1 — real execution (optional, OFF by default) ──────
# When set, the engineer agent (Forge) creates a REAL GitHub repo + commits code, and the result is
# verified before any task is marked done (verify-before-done). Without it, builds stay simulated.
# Use a fine-grained token with repo create/write scope. See lib/engine/execution.ts.
GITHUB_TOKEN=

# ── Phase 2 — deploy + comms (optional, OFF by default) ──────
# Vercel deploy hook (Project → Settings → Git → Deploy Hooks) + the live project URL (used as proof).
VERCEL_DEPLOY_HOOK_URL=
VERCEL_PROJECT_URL=
# Email (Resend) — approved outreach/support + the nightly morning summary.
RESEND_API_KEY=
RESEND_FROM=
CRON_SUMMARY_EMAIL=
OUTREACH_TO=
# Bluesky (AT Protocol) — the growth agent posts APPROVED updates for free. App-password from
# bsky.app → Settings → App Passwords (scoped + rotate-able); server-only. OFF until both are set.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ── Phase 3 — revenue + ads (optional, OFF by default) ───────
# Stripe — you keep 100% (no revenue share). Secret key + a Price ID to mint payment links.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Ads — POST approved ad specs to your own ad pipeline/webhook (Meta/Google run on your side).
ADS_WEBHOOK_URL=

# ── Supabase (auth + persistent multi-company store) ─────────
# When both are set, competitor.inc uses real auth + Postgres; otherwise it falls back to
# browser localStorage. See docs/SUPABASE-SETUP.md for the 3-step activation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Nightly heartbeat (Vercel Cron → /api/cron) ──────────────
# Service role lets the cron run shifts for all operating companies (server-only secret).
SUPABASE_SERVICE_ROLE_KEY=
# Optional: require this bearer token on the cron endpoint.
CRON_SECRET=

# ── Launch / payments (Founding-member checkout) ─────────────
# Your Merchant-of-Record checkout link (LemonSqueezy / Gumroad / Paddle). When set, the /join
# "Claim a Founding seat" button links here; otherwise it routes to the waitlist. No charges
# happen until you set this to your own store link.
NEXT_PUBLIC_CHECKOUT_URL=

# Canonical site URL — used for absolute OG/Twitter link-preview image URLs (scrapers reject relative
# ones). Defaults to the Vercel URL; set this to your custom domain at launch, e.g. https://competitor.inc
NEXT_PUBLIC_SITE_URL=

# Surprise-launch switch. While unset/"0", robots.txt blocks all crawling (private beta, no build-in-
# public). Set to "1" at launch to allow search engines to index the public surface + the playbooks
# sitemap. App/private routes (dashboard, house, auth) stay out of the index either way.
NEXT_PUBLIC_SITE_PUBLIC=

# ── Agent memory (pgvector) — Phase 4 ────────────────────────
# Persistent per-company memory so the crew gets sharper about each business over time. Needs Supabase
# (above) + the pgvector migration (supabase/migrations/0005_agent_memory.sql) + an embeddings key.
# Uses any OpenAI-compatible /embeddings endpoint. Unset = memory text still persists, but no semantic
# recall. Model must be 1536-dim to match the migration (text-embedding-3-small is).
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=

# ── Evals / observability (developer-side tracing) ───────────
# Framework-neutral trace sink for autonomous agent ops (latency, failure rate, drift) — distinct from
# the user-facing Glass Box. Point it at a Langfuse/LangSmith proxy, AI-Gateway log sink, or your own
# collector. Unset = every trace is a no-op (zero overhead). OBSERVABILITY_KEY is an optional bearer.
OBSERVABILITY_URL=
OBSERVABILITY_KEY=

# ── Feature flags ────────────────────────────────────────────
# Operate layer (EOS company-OS surface: Scorecard / Rocks / Issues / Weekly Review). ON by default
# now. Set to "0" to freeze it — the Jun 28 launch build should set "0" to shrink the launch surface
# until v0.2.0 (per docs/COMPANY-BLUEPRINT.md "launch first, Operate additively"). Any other value = on.
NEXT_PUBLIC_OPERATE=
# The House (/house) is PRIVATE — founder only. Comma-separated allow-list of founder emails allowed to
# view it once auth (Supabase) is on. Offline/local, access is an on-device unlock instead. There are
# no public links to /house; for hard privacy when deployed, also guard the route at the proxy layer.
NEXT_PUBLIC_FOUNDER_EMAILS=
