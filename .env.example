# competitor.inc — copy to .env.local and fill in. Everything is optional:
# with nothing set, the app runs fully in SIMULATED + local-storage mode (offline demo).

# ── Engine (swappable provider — the model is a commodity, never hardwired) ──
# MODEL_PROVIDER: "simulated" (default, offline) | "anthropic" | "gateway" | "openai-compatible"
# THIS is the one that makes the AI real — set it + the matching key below and the agents stop simulating.
MODEL_PROVIDER=simulated
# MODEL_ID is used by ALL real providers (for "gateway", use a "provider/model" string).
# Default: claude-sonnet-4-6 (the in-house agents run on Sonnet 4.6 for now).
MODEL_ID=claude-sonnet-4-6
# Per-agent routing: cheaper/faster model for non-strategic agents (Forge/Apex use MODEL_ID).
# Defaults to Sonnet 4.6 too for now; set e.g. claude-haiku-4-5 to split the lighter roles off later.
MODEL_CHEAP=claude-sonnet-4-6
#
# (a) Anthropic            → MODEL_PROVIDER=anthropic     (simplest; use Claude-for-Startups credits)
ANTHROPIC_API_KEY=
# (b) Vercel AI Gateway    → MODEL_PROVIDER=gateway       (one key, any provider via "provider/model")
AI_GATEWAY_API_KEY=
# (c) Any OpenAI-compatible / self-hosted host (OpenAI, Groq, OpenRouter, Together, Mistral,
#     DeepSeek, a local server, …) → MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
#
#   ►► FREE real AI at ~$0 (the metered-launch path — pick one, paste a free key):
#      Groq (fast, no card):      MODEL_PROVIDER=openai-compatible
#                                 MODEL_BASE_URL=https://api.groq.com/openai/v1  MODEL_API_KEY=<gsk_…>
#                                 MODEL_ID=llama-3.3-70b-versatile   MODEL_MID=llama-3.3-70b-versatile
#                                 MODEL_CHEAP=llama-3.1-8b-instant
#      ⚠️  With Groq as the MANAGED provider you MUST set ALL THREE (MODEL_ID/MODEL_MID/MODEL_CHEAP) to Groq
#      ids. Agents route by tier (server.ts): cheap→MODEL_CHEAP, mid→MODEL_MID, strong→MODEL_ID. Leaving
#      MID/CHEAP at their Claude defaults sends a Claude model name to Groq → 400 → silent fallback (e.g.
#      /sell returns the generic template). FREE_TIER_* is a DIFFERENT hybrid path (Claude for mid/strong +
#      Groq for cheap) that needs a PAID Anthropic key — so it is NOT the $0 setup. See docs/LAUNCH-SWITCHES.md.
#      Cerebras (~1M tok/day):    MODEL_BASE_URL=https://api.cerebras.ai/v1   MODEL_ID=llama-3.3-70b
#      OpenRouter (free models):  MODEL_BASE_URL=https://openrouter.ai/v1     MODEL_ID=<a :free model>
#   Cost stays bounded by the in-app free-tier caps (validate 3/day, shift 12/day) + per-IP rate limit
#   + the provider's own free limits. Verify current model ids/limits (they change). See docs/intel/free-ai-stack.md.
# Users can also Bring Their Own Key in the UI (stored only in their browser, sent per-request).

# ── Phase 1 — real execution (optional, OFF by default) ──────
# When set, the engineer agent (Forge) creates a REAL GitHub repo + commits code, and the result is
# verified before any task is marked done (verify-before-done). Without it, builds stay simulated.
# Use a fine-grained token with repo create/write scope. See lib/engine/execution.ts.
GITHUB_TOKEN=
# FULL-STACK builds (#1): real Next.js + API routes → Vercel, built free via GitHub Actions + Aider. OFF by
# default. Set "1" to enable (needs a GITHUB_TOKEN with the `workflow` scope). The model + deploy keys live as
# REPO SECRETS the founder sets on each build repo: LLM_API_KEY (free model, e.g. Groq) + VERCEL_TOKEN.
# Fail-soft: off/unconfigured → falls back to the static build. See docs/plans/fullstack-builds.md.
FULLSTACK_BUILDS=
FULLSTACK_BUILD_MODEL=
# The engine injects these two as per-repo Actions secrets on each generated build repo (no GitHub org
# needed). Set them ONCE here: the free model key (e.g. Groq) + a Vercel deploy token. These ARE secrets.
FULLSTACK_LLM_API_KEY=
FULLSTACK_VERCEL_TOKEN=
# Optional: create build repos under a GitHub ORG instead of the user account (blank = user account, which
# now works fine thanks to per-repo secret injection).
FULLSTACK_GH_ORG=

# ── Phase 2 — deploy + comms (optional, OFF by default) ──────
# Vercel deploy hook (Project → Settings → Git → Deploy Hooks) + the live project URL (used as proof).
VERCEL_DEPLOY_HOOK_URL=
VERCEL_PROJECT_URL=
# Email (Resend) — approved outreach/support + the nightly morning summary.
RESEND_API_KEY=
RESEND_FROM=
CRON_SUMMARY_EMAIL=
OUTREACH_TO=
# Where founder notifications (new waitlist signups, beta feedback) are emailed. Needs Resend (above).
# Defaults to projecttattva1@gmail.com.
FOUNDER_NOTIFY_EMAIL=
# Customer build-updates (opt-in) — a Telegram bot that pings the USER when their crew validates an idea
# or finishes a shift. Create a bot via @BotFather → paste its token. Provider-agnostic (lib/engine/
# notify.ts): Linqapp iMessage / SMS drop in later. Unset = /api/notify is a no-op. The user opts in by
# messaging the bot, then pasting their chat id in Settings (we can't auto-pull it from Google sign-in).
TELEGRAM_BOT_TOKEN=
# ChatOps — approve/reject consequential moves from your phone. A long random string you pass to Telegram
# at setWebhook time (secret_token); the webhook (/api/telegram/webhook) checks it constant-time. The
# decision is recorded in approval_decisions (migration 0007) and the app applies it on next sync. Unset
# ⇒ the webhook ignores everything (fail-closed). One-time setup: see docs/CHATOPS.md.
TELEGRAM_WEBHOOK_SECRET=
# Autonomous marketing — competitor.inc's OWN "roomie" bot accounts post APPROVED campaign updates that
# market each user's company (branded, with their link). Free, bot-friendly, approval/policy-gated.
# Bluesky (AT Protocol): app-password from bsky.app → Settings → App Passwords (scoped, rotate-able).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Mastodon: an access token from your instance → Preferences → Development → New application (scope: write:statuses).
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=

# ── Phase 3 — revenue + ads (optional, OFF by default) ───────
# Stripe — you keep 100% (no revenue share). Secret key + a Price ID to mint payment links.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Ads — POST approved ad specs to your own ad pipeline/webhook (Meta/Google run on your side).
ADS_WEBHOOK_URL=

# ── Supabase (auth + persistent multi-company store) ─────────
# When both are set, competitor.inc uses real auth + Postgres; otherwise it falls back to
# browser localStorage. See docs/SUPABASE-SETUP.md for the 3-step activation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Nightly heartbeat (Vercel Cron → /api/cron) ──────────────
# Service role lets the cron run shifts for all operating companies (server-only secret).
SUPABASE_SERVICE_ROLE_KEY=
# Optional: require this bearer token on the cron endpoint.
CRON_SECRET=

# ── Payments — the founder tier ladder (Polar, Merchant-of-Record) ─────────
# Source of truth = lib/engine/billing.ts TIERS. Each PAID tier is its own Polar product = its own
# checkout link. tierOf() (entitlement.ts) maps by SUBSTRING of the Polar product name / metadata.plan,
# so name each product with its keyword (builder / operator / concierge) or it fail-opens to "operator".
# All NEXT_PUBLIC_CHECKOUT_URL* are NON-sensitive (sensitive NEXT_PUBLIC vars don't inline to the client).
# Until NEXT_PUBLIC_CHECKOUT_URL is set, Build stays open (the demo works) — nothing charges. Full runbook:
# docs/LAUNCH-SWITCHES.md §B.
#   OPERATOR  = $199/mo — this base URL; ALSO gates Build/reveal (the /join primary CTA).
NEXT_PUBLIC_CHECKOUT_URL=
#   BUILDER   = $49/mo  — build-only tier.
NEXT_PUBLIC_CHECKOUT_URL_BUILDER=
#   CONCIERGE = $499/mo — done-with-you / "founder" tier (the /join "Apply for a slot" CTA).
NEXT_PUBLIC_CHECKOUT_URL_FOUNDER=
#   SPRINT    = optional one-time "Validation Sprint" (latent; not shown on /join unless you use it).
NEXT_PUBLIC_CHECKOUT_URL_SPRINT=
# LemonSqueezy is RETIRED (migrated to Polar — one provider writes `entitlements`). Leave this blank.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Polar (Merchant of Record) webhook signing secret → /api/billing/polar (Standard Webhooks signed).
# Create the endpoint in Polar → Settings → Webhooks (events: subscription.* + order.paid); paste its
# secret here. Same entitlements table as above — only one billing provider needs to be live at a time.
POLAR_WEBHOOK_SECRET=

# Canonical site URL — used for absolute OG/Twitter link-preview image URLs (scrapers reject relative
# ones). Defaults to the Vercel URL; set this to your custom domain at launch, e.g. https://competitor.inc
NEXT_PUBLIC_SITE_URL=

# Surprise-launch switch. While unset/"0", robots.txt blocks all crawling (private beta, no build-in-
# public). Set to "1" at launch to allow search engines to index the public surface + the playbooks
# sitemap. App/private routes (dashboard, house, auth) stay out of the index either way.
NEXT_PUBLIC_SITE_PUBLIC=

# ── Agent memory (pgvector) — Phase 4 ────────────────────────
# Persistent per-company memory so the crew gets sharper about each business over time. Needs Supabase
# (above) + the pgvector migration (supabase/migrations/0005_agent_memory.sql) + an embeddings key.
# Uses any OpenAI-compatible /embeddings endpoint. Unset = memory text still persists, but no semantic
# recall. Model must be 1536-dim to match the migration (text-embedding-3-small is).
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=

# ── Evals / observability (developer-side tracing) ───────────
# Framework-neutral trace sink for autonomous agent ops (latency, failure rate, drift) — distinct from
# the user-facing Glass Box. Point it at a Langfuse/LangSmith proxy, AI-Gateway log sink, or your own
# collector. Unset = every trace is a no-op (zero overhead). OBSERVABILITY_KEY is an optional bearer.
OBSERVABILITY_URL=
OBSERVABILITY_KEY=

# ── Founder KPI board (/house/board) ─────────────────────────
# A shared secret that unlocks the aggregate funnel board (waitlist, demand tests). Unset = board off.
# Set a long random string; paste the same value into the board once (kept on your device only).
METRICS_SECRET=

# ── Feature flags ────────────────────────────────────────────
# Operate layer (EOS company-OS surface: Scorecard / Rocks / Issues / Weekly Review). ON by default
# now. Set to "0" to freeze it — the Jun 28 launch build should set "0" to shrink the launch surface
# until v0.2.0 (per docs/COMPANY-BLUEPRINT.md "launch first, Operate additively"). Any other value = on.
NEXT_PUBLIC_OPERATE=
# Server-authoritative state: Supabase becomes the single source of truth for signed-in users (reads load
# from the DB, writes are awaited + rollback on failure, cron/multi-device changes arrive via Realtime).
# Default OFF (unset/any non-"1") = today's behavior (localStorage-authoritative + best-effort sync); this is
# the clean rollback switch. Set "1" to enable. Guests are always localStorage-only regardless.
NEXT_PUBLIC_SERVER_AUTHORITATIVE=
# Sentry error tracking (fail-soft — inert unless a DSN is set). Provision via `vercel integration add sentry`
# (auto-sets these) or paste the DSN from sentry.io. NEXT_PUBLIC_SENTRY_DSN is safe to expose (it's a DSN, not
# a secret). SENTRY_AUTH_TOKEN (optional) enables source-map upload during build; without it, upload is skipped.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# The House (/house) is PRIVATE — founder only. Comma-separated allow-list of founder emails allowed to
# view it once auth (Supabase) is on. Offline/local, access is an on-device unlock instead. There are
# no public links to /house; for hard privacy when deployed, also guard the route at the proxy layer.
NEXT_PUBLIC_FOUNDER_EMAILS=

# ── env-guard-documented public flags (each MUST be non-Sensitive on Vercel: Sensitive NEXT_PUBLIC_*
# vars are NOT inlined into the client bundle — a flag can look on server-side while silently off in
# the browser; scripts/env-guard.mjs enforces this manifest on every QA run) ──
# THE LAUNCH SWITCH: "1" restricts sign-ins to verified @northeastern.edu (+ founder allow-list) at the
# OAuth callback AND the middleware. Default off — the site stays open/dark until the NU launch.
NEXT_PUBLIC_CAMPUS_GATE=
# Client-visible engine mode label (simulated|anthropic|gateway|openai-compatible). The server's
# MODEL_PROVIDER is authoritative; this only lets the UI describe the active mode honestly.
NEXT_PUBLIC_MODEL_PROVIDER=
# "1" gates execution behind the waitlist during closed beta (see /api/execute + /join).
NEXT_PUBLIC_WAITLIST_GATE=
