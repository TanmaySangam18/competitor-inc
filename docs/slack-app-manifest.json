{
  "display_information": {
    "name": "competitor.inc crew",
    "description": "Your crew in Slack: ask questions, get approvals, receive the Friday review.",
    "background_color": "#14130e"
  },
  "features": {
    "bot_user": {
      "display_name": "competitor-crew",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "channels:history", "im:history"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://competitor-inc-zeta.vercel.app/api/slack/webhook",
      "bot_events": ["message.channels", "message.im"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://competitor-inc-zeta.vercel.app/api/slack/webhook"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false
  }
}
