{
  "name": "competitor-inc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port ${PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prove": "vitest run lib/sim/proving-ground.report.test.ts --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && vitest run && next build",
    "qa": "node scripts/env-guard.mjs && tsc --noEmit && vitest run && next build && node scripts/smoke.mjs",
    "scan": "node scripts/secret-scan.mjs",
    "qa:ui": "node scripts/qa-ui-audit.mjs",
    "ship": "bash scripts/ship-prod.sh"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.64.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.0.0",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.511.0",
    "next": "^16.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "fast-check": "^4.8.0",
    "js-yaml": "^5.2.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
